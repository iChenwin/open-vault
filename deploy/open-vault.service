[Unit]
Description=Open Vault CBT web console
After=network-online.target
Wants=network-online.target
After=open-vault-cbt-agent.service

[Service]
Type=simple
User=open-vault
Group=open-vault
ExecStart=/usr/local/bin/open-vault -config /etc/open-vault/config.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
